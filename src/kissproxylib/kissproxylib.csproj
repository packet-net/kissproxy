<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>m0lte.kissproxylib</PackageId>
    <Version>0.0.4</Version>
    <Authors>Tom Fanning</Authors>
    <RootNamespace>kissproxylib</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="M0LTE.Tait.Ccdi" Version="0.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.34" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.23" />
    <PackageReference Include="MQTTnet.Extensions.ManagedClient" Version="4.3.7.1207" />
    <PackageReference Include="NAx25" Version="1.0.10" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>